[user]
    name = Sebastiaan Gerritsen
    email = sebastiaan@ducklabs.com

[init]
    defaultBranch = main

[pull]
    rebase = false
    ff = true

[color]
    ui = auto

[core]
    excludesFile = ~/.config/git/ignore
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    syntax-theme = Nord
