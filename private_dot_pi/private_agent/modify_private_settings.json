#!/usr/bin/env python3
"""Manage Pi's theme while preserving its local provider and other settings."""

import json
import sys

original = sys.stdin.read()
content = original.lstrip("\ufeff").strip()
settings = json.loads(content) if content else {}
if not isinstance(settings, dict):
    sys.exit("Pi settings.json must contain a JSON object.")

if settings.get("theme") == "kanso-mist":
    sys.stdout.write(original)
else:
    settings["theme"] = "kanso-mist"
    json.dump(settings, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
