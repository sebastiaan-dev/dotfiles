# Tools installed by bootstrap.sh.
typeset -U path fpath
path=(/opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/go/bin" "$HOME/.cargo/bin" $path)
export PATH

# Initialize Homebrew on Apple Silicon or Intel Macs.
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# Use the managed ccache configuration on macOS and Linux.
export CCACHE_CONFIGPATH="$HOME/.config/ccache/ccache.conf"

# Activate per-project tool versions and environments.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Navigation and terminal shortcuts.
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# File listings with eza.
alias ll='eza -l --group-directories-first'
alias la='eza -la --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'

# Git shortcuts.
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --graph --oneline --decorate --all'

# Editor and dotfile tools.
alias lg='lazygit'
alias n='nvim'
alias cz='chezmoi'

# Load additional local shell configuration and alias overrides.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# fzf file/directory widgets; Atuin below keeps ownership of Ctrl-R.
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

# Atuin replaces Ctrl-R history search; keep normal Up-arrow behavior.
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# Smart directory navigation: z <name> and zi for interactive selection.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Allow Worktrunk to switch the current shell into a worktree.
if command -v wt >/dev/null 2>&1; then
  eval "$(wt config shell init zsh)"
fi

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "c0c7db20dcdc") -}}
# Amazon Toolbox on this work Mac.
export PATH="$HOME/.toolbox/bin:$PATH"
{{ end -}}

# Nord's bracketed, multiline Igloo prompt.
if [[ -r "$HOME/.config/zsh/prompts/prompt_igloo_setup" ]]; then
  [[ -r "$HOME/.config/zsh/git-prompt.sh" ]] && source "$HOME/.config/zsh/git-prompt.sh"
  fpath=("$HOME/.config/zsh/prompts" $fpath)
  IGLOO_ZSH_PROMPT_THEME_ALWAYS_SHOW_USER=${IGLOO_ZSH_PROMPT_THEME_ALWAYS_SHOW_USER:-true}
  autoload -Uz promptinit
  promptinit
  prompt igloo
fi

# Load syntax highlighting after all Zsh widgets and hooks.
if [[ -n "${HOMEBREW_PREFIX:-}" && -r "${HOMEBREW_PREFIX:-}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
