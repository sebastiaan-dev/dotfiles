# Tools installed by bootstrap.sh.
typeset -U path fpath
path=(/opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/go/bin" "$HOME/.cargo/bin" $path)
export PATH

# Initialize Homebrew on Apple Silicon or Intel Macs.
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# Use the managed ccache configuration on macOS and Linux.
export CCACHE_CONFIGPATH="$HOME/.config/ccache/ccache.conf"

# Activate per-project tool versions and environments.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Navigation and terminal shortcuts.
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# File listings with eza.
alias ll='eza -l --group-directories-first'
alias la='eza -la --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'

# Git shortcuts.
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --graph --oneline --decorate --all'

# DuckDB shortcuts, available only from ~/repos and its worktrees.
_jrepos() {
  case "$PWD/" in
    "$HOME/repos/"*) command just "$@" ;;
    *) print -u2 'DuckDB shortcuts are available only under ~/repos'; return 2 ;;
  esac
}
alias jb='_jrepos build'
alias jf='_jrepos format'
alias jt='_jrepos slt'

# Editor and dotfile tools.
alias lg='lazygit'
alias n='nvim'
alias cz='chezmoi'

# Create or attach to a tmux session with an explicit name.
tn() {
  if (( $# != 1 )) || [[ -z "${1:-}" ]]; then
    print -u2 'Usage: tn <session-name>'
    return 2
  fi
  local session_name="$1"
  if [[ -n "${TMUX:-}" ]]; then
    if ! command tmux has-session -t "=$session_name" 2>/dev/null; then
      command tmux new-session -d -s "$session_name" || return
    fi
    command tmux switch-client -t "=$session_name"
  else
    command tmux new-session -A -s "$session_name"
  fi
}

# Load additional local shell configuration and alias overrides.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Initialize command completion, including targets from the current Makefile.
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "${HOMEBREW_PREFIX}/share/zsh/site-functions" ]]; then
  fpath=("${HOMEBREW_PREFIX}/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit
compinit

# fzf file/directory widgets; Atuin below keeps ownership of Ctrl-R.
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

# Atuin replaces Ctrl-R history search; keep normal Up-arrow behavior.
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# Smart directory navigation through Zoxide.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd=z
fi

# Allow Worktrunk to switch the current shell into a worktree.
if command -v wt >/dev/null 2>&1; then
  eval "$(wt config shell init zsh)"
fi

{{ if and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "c0c7db20dcdc") -}}
# Amazon Toolbox on this work Mac.
export PATH="$HOME/.toolbox/bin:$PATH"
{{ end -}}

# Compact Nord prompt: one information row above the command input.
if [[ -r "$HOME/.config/zsh/prompts/prompt_nord_setup" ]]; then
  [[ -r "$HOME/.config/zsh/git-prompt.sh" ]] && source "$HOME/.config/zsh/git-prompt.sh"
  [[ -r "$HOME/.config/zsh/async.zsh" ]] && source "$HOME/.config/zsh/async.zsh"
  fpath=("$HOME/.config/zsh/prompts" $fpath)
  autoload -Uz promptinit
  promptinit
  prompt nord
fi

# Load syntax highlighting after all Zsh widgets and hooks.
if [[ -n "${HOMEBREW_PREFIX:-}" && -r "${HOMEBREW_PREFIX:-}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "${HOMEBREW_PREFIX}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
