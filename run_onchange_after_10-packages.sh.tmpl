{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Rerun when the package list changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
export PATH="$HOME/.local/bin:/opt/nanobrew/prefix/bin:$PATH"

if ! command -v nb >/dev/null 2>&1; then
  echo 'nanobrew is missing. Run bootstrap.sh first.' >&2
  exit 1
fi

nb bundle install {{ joinPath .chezmoi.destDir "Brewfile" | quote }}

# cmake-format is distributed by the upstream cmakelang Python package.
# Python 3.11 preserves compatibility with its older Python tooling.
uv tool install --python 3.11 'cmakelang[YAML]==0.6.13'
{{- end }}
