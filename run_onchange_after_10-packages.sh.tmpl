{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Rerun when the package list changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

if ! command -v brew >/dev/null 2>&1; then
  echo 'Homebrew is missing. Run bootstrap.sh first.' >&2
  exit 1
fi

eval "$(brew shellenv)"
brew bundle install --no-upgrade --file={{ joinPath .chezmoi.destDir "Brewfile" | quote }}

# cmake-format is distributed by the upstream cmakelang Python package.
# Python 3.11 preserves compatibility with its older Python tooling.
uv tool install --python 3.11 'cmakelang[YAML]==0.6.13'

# gperftools no longer bundles a profile viewer. Install Google's pinned pprof.
mkdir -p "$HOME/.local/bin"
# Fetch from upstream; the public Go proxy does not resolve on this device.
# Go's checksum verification remains enabled.
GOPROXY="${GOPROXY:-direct}" \
  GOBIN="$HOME/.local/bin" mise exec go@1.27.1 -- \
  go install github.com/google/pprof@v0.0.0-20261001064331-60bf690a9302
{{- end }}
